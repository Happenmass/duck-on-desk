{
  "schemaVersion": 1,
  "name": "Duck",
  "author": "guhappen",
  "version": "0.1.0",
  "description": "Physics-driven 3D Microduck. State files are intent ids consumed by renderer/src/agent-visual-adapter.js.",
  "renderer": "duck3d",
  "viewBox": { "x": 0, "y": 0, "width": 330, "height": 390 },
  "layout": {
    "contentBox": { "x": 60, "y": 30, "width": 210, "height": 340 },
    "centerX": 165,
    "baselineY": 370,
    "visibleHeightRatio": 0.9,
    "baselineBottomRatio": 0.03
  },
  "objectScale": { "widthRatio": 1, "heightRatio": 1, "offsetX": 0, "offsetY": 0 },
  "eyeTracking": { "enabled": true, "states": ["idle"], "eyeRatioX": 0.5, "eyeRatioY": 0.5, "maxOffset": 3, "bodyScale": 0, "shadowStretch": 0, "shadowShift": 0 },
  "states": {
    "idle": ["duck-idle"],
    "roam": ["duck-idle"],
    "dizzy": ["duck-idle"],
    "thinking": ["duck-thinking"],
    "working": ["duck-working"],
    "juggling": ["duck-juggling"],
    "carrying": ["duck-carrying"],
    "sweeping": ["duck-sweeping"],
    "attention": ["duck-attention"],
    "notification": ["duck-notification"],
    "error": ["duck-error"],
    "sleeping": ["duck-sleeping"],
    "waking": ["duck-waking"]
  },
  "sleepSequence": { "mode": "direct" },
  "timings": {
    "minDisplay": { "attention": 3000, "error": 5000, "sweeping": 4000, "notification": 2500, "carrying": 3000, "working": 1000, "thinking": 1000 },
    "autoReturn": { "attention": 4000, "error": 6000, "sweeping": 300000, "notification": 2500, "carrying": 3000 },
    "yawnDuration": 0,
    "wakeDuration": 1500,
    "deepSleepTimeout": 600000,
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 240000
  },
  "hitBoxes": {
    "default": { "x": 95, "y": 40, "w": 140, "h": 330 },
    "sleeping": { "x": 80, "y": 150, "w": 170, "h": 220 }
  },
  "sounds": {},
  "miniMode": { "supported": false }
}
