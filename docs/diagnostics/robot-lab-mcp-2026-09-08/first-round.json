        "artifact": "reward.py",
        "content": "def reward(observation, action, next_observation):\n    \"\"\"Synthetic probe only; index 0 is NOT a robot speed contract.\"\"\"\n    feature_error = next_observation[:, 0] - 0.2\n    return -(feature_error ** 2) - 0.01 * (action ** 2).sum(dim=-1)\n"
      }
