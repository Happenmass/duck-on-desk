{
  "name": "duck-on-desk",
  "version": "1.0.0",
  "description": "A desktop pet that reacts to your Claude Code sessions in real-time.",
  "main": "src/main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --win",
    "build:win:x64": "electron-builder --win nsis:x64",
    "build:win:arm64": "electron-builder --win nsis:arm64",
    "build:win:all": "electron-builder --win nsis:x64 nsis:arm64",
    "build:mac": "electron-builder --mac",
    "build:mac:x64": "electron-builder --mac dmg:x64 zip:x64",
    "build:mac:arm64": "electron-builder --mac dmg:arm64 zip:arm64",
    "build:all": "electron-builder --mac --win",
    "verify:electron": "node scripts/verify-electron-install.js",
    "postinstall": "node scripts/verify-electron-install.js --context postinstall",
    "test": "node test/run-tests.js",
    "audit:assets": "node scripts/audit-repository-assets.js",
    "audit:native-package": "node scripts/audit-packaged-native.js",
    "verify:updater-metadata": "node scripts/verify-updater-metadata.js",
    "verify:release": "node scripts/verify-release-version.js && node scripts/verify-release-contributors.js",
    "create-theme": "node scripts/create-theme.js",
    "export-agent-icons": "node scripts/export-agent-icons.js",
    "install:claude-hooks": "node hooks/install.js",
    "uninstall:claude-hooks": "node hooks/uninstall.js",
    "install:pi-extension": "node hooks/pi-install.js",
    "uninstall:pi-extension": "node hooks/pi-install.js --uninstall",
    "install:codex-hooks": "node hooks/codex-install.js",
    "uninstall:codex-hooks": "node hooks/codex-install.js --uninstall",
    "cleanup:integrations": "node hooks/cleanup-integrations.js --apply",
    "register-protocol:dev": "node launch.js --register-protocol",
    "setup:models": "node renderer/scripts/link-model-cache.mjs",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "dev:renderer": "vite --config renderer/vite.config.js --host 127.0.0.1",
    "prestart": "npm run build:renderer",
    "prebuild:mac": "npm run build:renderer",
    "prebuild:win:all": "npm run build:renderer"
  },
  "keywords": [
    "duck",
    "desktop-pet",
    "electron",
    "claude-code"
  ],
  "author": "rullerzhou-afk",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "build": {
    "appId": "com.guhappen.duck-on-desk",
    "productName": "Duck on Desk",
    "afterPack": "scripts/after-pack-koffi.js",
    "protocols": [
      {
        "name": "Duck Import Protocol",
        "schemes": [
          "duck"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "identity": "-",
      "artifactName": "Duck-on-Desk-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Duck-on-Desk-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "files": [
      "NOTICE.md",
      "src/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "assets/sounds/**/*",
      "assets/dock-icon.png",
      "assets/tray-icon*.png",
      "hooks/**/*",
      "extensions/**/*",
      "agents/**/*",
      "themes/**/*",
      "renderer-dist/**/*"
    ],
    "asarUnpack": [
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "hooks/**/*",
      "extensions/**/*",
      "agents/**/*",
      "themes/**/*",
      "node_modules/jsonc-parser/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "guhappen",
        "repo": "duck-on-desk"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@mujoco/mujoco": "^3.12.0",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.7",
    "onnxruntime-web": "^1.29.0",
    "three": "^0.164.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "htmlparser2": "^12.0.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "2.16.3",
    "markdown-it": "15.0.0",
    "ws": "^8.21.0"
  }
}
